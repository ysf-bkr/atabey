{
  "name": "atabey-mcp",
  "version": "0.1.7",
  "description": "Atabey MCP — Tool governance and verification server for AI coding agents",
  "author": "Yusuf BEKAR",
  "license": "AGPL-3.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "local-ai-governance",
    "coding-agent",
    "claude-code",
    "cursor-ide",
    "governance",
    "policy",
    "audit",
    "verification",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ysf-bkr/atabey.git",
    "directory": "packages/atabey-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "atabey-mcp": "bin/cli.js"
  },
  "main": "./dist/atabey-mcp/src/mcp/index.js",
  "types": "./dist/atabey-mcp/src/mcp/index.d.ts",
  "exports": {
    ".": "./dist/atabey-mcp/src/mcp/index.js",
    "./modules/*": "./dist/atabey-mcp/src/mcp/modules/*",
    "./utils/*": "./dist/atabey-mcp/src/mcp/utils/*",
    "./shared/*": "./dist/atabey-mcp/src/shared/*"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests --ext .ts",
    "prepublishOnly": "node ../../scripts/build-readmes.mjs && npm run build"
  },
  "dependencies": {
    "atabey": "^0.1.7",
    "atabey-shared": "^0.1.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.2",
    "chalk": "^5.6.2",
    "typescript": "^5.9.3",
    "ws": "^8.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.22.3",
    "vitest": "^5.0.0"
  }
}
