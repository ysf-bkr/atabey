# Atabey — Environment Variables
# NOTE: Atabey does NOT auto-load .env files. Copy values into your shell
# profile, IDE launch config, or CI secrets — exporting them in the environment
# is what activates them.

# ─── Server Configuration ─────────────────────────────────────────
# MCP Transport mode: "stdio" (default — IDE-spawned, JSON-RPC over stdin/stdout)
# or "unified" (MCP HTTP/SSE on a single port).
# MCP_TRANSPORT=stdio

# Server host — keep 127.0.0.1 (loopback) unless you explicitly need remote
# access; 0.0.0.0 exposes the hub and its file tools to the whole network.
# MCP_HOST=127.0.0.1

# Server port (default: 5858 for unified mode)
# MCP_PORT=5858

# Project root directory (required in SSE/network mode)
# ATABEY_PROJECT_ROOT=/path/to/your/project

# Framework directory (optional, default: .atabey in project root)
# ATABEY_FRAMEWORK_DIR=.atabey

# Node environment (production/development/test)
# NODE_ENV=development

# ─── Security / Authentication (Phase 2.1) ────────────────────────
# Fail closed: deny unauthenticated HTTP/SSE when true (enterprise default)
# MCP_AUTH_REQUIRED=true
# ATABEY_AUTH_REQUIRED=true

# ─── Transport Security: TLS 1.3 + mTLS ───────────────────────────
# Encrypt all HTTP/SSE/WebSocket traffic. Enable by providing a cert+key
# (auto-enabled) or set ATABEY_TLS_ENABLED=true.
# ATABEY_TLS_CERT_FILE=/etc/atabey/tls/server.crt
# ATABEY_TLS_KEY_FILE=/etc/atabey/tls/server.key
# Minimum protocol version: TLSv1.3 (default) or TLSv1.2
# ATABEY_TLS_MIN_VERSION=TLSv1.3
# Mutual TLS: require + verify client certificates (needs the client CA bundle)
# ATABEY_TLS_CA_FILE=/etc/atabey/tls/client-ca.crt
# ATABEY_MTLS_REQUIRED=true
# Fail hard if TLS is not configured (recommended in production)
# ATABEY_TLS_REQUIRED=true
# Allow plaintext binding to a non-loopback host (NOT recommended)
# ATABEY_ALLOW_INSECURE_BIND=false

# Master API key for MCP server authentication.
# If set (or required), API/MCP HTTP requests need Authorization: Bearer <token>
# MCP_AUTH_TOKEN=

# Per-user API tokens (comma-separated, format: user1:token1,user2:token2)
# MCP_AUTH_USERS=

# OIDC prep (JWT enforcement in Phase 2.2)
# ATABEY_OIDC_ISSUER=https://login.example.com/
# ATABEY_OIDC_AUDIENCE=atabey-api
# ATABEY_OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json

# ─── AI Discipline Engine ─────────────────────────────────────────
# Max tool calls per minute per agent (default: 60)
# MCP_MAX_CALLS_PER_MINUTE=60

# Max total tool calls per session (default: 500)
# MCP_MAX_TOTAL_CALLS=500

# Max file size for read/write in bytes (default: 1048576 = 1MB)
# MCP_MAX_FILE_SIZE=1048576

# Max args size for any tool call in bytes (default: 102400 = 100KB)
# MCP_MAX_ARGS_SIZE=102400

# Cooldown period after limit hit in ms (default: 30000 = 30s)
# MCP_COOLDOWN_MS=30000

# Max response size in bytes (default: 512000 = 500KB)
# MCP_MAX_RESPONSE_SIZE=512000

# Max consecutive same tool calls before loop detection (default: 10)
# MCP_MAX_CONSECUTIVE_SAME_TOOL=10

# Restricted tools (comma-separated, always blocked)
# MCP_RESTRICTED_TOOLS=run_shell_command,check_active_ports

# Agent-based tool whitelist (format: agent1:tool1,tool2;agent2:tool3,tool4)
# MCP_AGENT_TOOL_WHITELIST=

# ─── AI Provider Keys ─────────────────────────────────────────────
# OpenAI API key (used for embeddings)
# Get key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# ─── Data Retention ───────────────────────────────────────────────
# How long to keep audit logs, messages, and records (in days, default: 30)
# ATABEY_DATA_RETENTION_DAYS=30

# ─── Job Queue / Worker Pool (no Redis / BullMQ) ───────────────────
# Max concurrent agent jobs on the in-memory queue (default: os.cpus().length, max 16)
# ATABEY_JOB_CONCURRENCY=4

# Max concurrent worker_threads for CPU-isolable work (default: os.cpus().length, max 16)
# ATABEY_WORKER_CONCURRENCY=4

# ─── Sandbox Runtime (Phase 1.1) ───────────────────────────────────
# ATABEY_SANDBOX_RUNTIME=auto|none|uid|seatbelt
#   auto      = seatbelt if available on macOS, else uid if configured, else none
#   seatbelt  = macOS kernel sandbox (/usr/bin/sandbox-exec), writes confined
#               to projectRoot, network denied by default
#   uid       = host spawn with dropped privileges (POSIX uid/gid)
#   none      = host process (allow-list only)
# ATABEY_SANDBOX_RUNTIME=auto

# Fail closed when no isolation available (recommended for enterprise)
# ATABEY_SANDBOX_REQUIRED=true

# Deny network inside the seatbelt sandbox (default: none)
# ATABEY_SANDBOX_NETWORK=none

# ─── OS uid/gid isolation (used when runtime=uid or auto fallback) ─
# ATABEY_SANDBOX_ENABLED=true
# ATABEY_SANDBOX_USER=atabey-sandbox
# ATABEY_SANDBOX_UID=501
# ATABEY_SANDBOX_GID=20

# ─── Hub Bridge & Port Resilience ──────────────────────────────────
# Allow a stdio MCP process to attach to an existing verified hub (same
# project + same version) instead of starting its own server. Off by default.
# ATABEY_ALLOW_HUB_BRIDGE=false
# Fail fast on EADDRINUSE instead of falling back to the next free port.
# ATABEY_PORT_STRICT=false

# ─── Sandbox ───────────────────────────────────────────────────────
# Sandbox runtime: none | uid | seatbelt | auto (default: auto)
# ATABEY_SANDBOX_RUNTIME=auto
# Deny execution when OS isolation is unavailable (fail-closed).
# ATABEY_SANDBOX_REQUIRED=false
# ATABEY_SANDBOX_UID=
# ATABEY_SANDBOX_GID=
# ATABEY_ALLOW_UNSANDBOXED=false

# ─── RBAC / Permissions ────────────────────────────────────────────
# Deny tool calls that have no matching permission-matrix rule.
# ATABEY_PERMISSIONS_DENY_BY_DEFAULT=false
# Active agent identity for tool calls (set by agent runtimes).
# ATABEY_ACTIVE_AGENT=
# ATABEY_ALLOWED_TOOLS=
# ATABEY_DISABLED_TOOLS=

# ─── Auth / Tokens ─────────────────────────────────────────────────
# Require bearer-token auth on the HTTP/SSE API.
# ATABEY_AUTH_REQUIRED=false
# MCP_AUTH_TOKEN=
# MCP_AUTH_REQUIRED=false
# ATABEY_MASTER_KEY=

# ─── TLS / mTLS ────────────────────────────────────────────────────
# ATABEY_TLS_REQUIRED=false
# ATABEY_TLS_CERT_FILE=
# ATABEY_TLS_KEY_FILE=
# ATABEY_TLS_CA_FILE=
# ATABEY_MTLS_REQUIRED=false
# ATABEY_TLS_CLIENT_CERT_FILE=
# ATABEY_TLS_CLIENT_KEY_FILE=
# ATABEY_TLS_CLIENT_CA_FILE=
# ATABEY_TLS_CLIENT_MIN_VERSION=

# ─── Audit & Integrity ─────────────────────────────────────────────
# HMAC key for the tamper-evident audit chain.
# ATABEY_AUDIT_HMAC_KEY=
# ATABEY_AUDIT_HMAC_AUTOCREATE=true
# Detect out-of-band (unaudited) file writes via hash diffing.
# ATABEY_ENFORCE_UNAUDITED_WRITES=false

# ─── Orchestrator / Agent Loop ─────────────────────────────────────
# ATABEY_AUTO_START_ORCHESTRATOR=true
# ATABEY_ORCHESTRATOR_INTERVAL_MS=1000
# ATABEY_JOB_CONCURRENCY=8
# ATABEY_AUTO_RESTART=true
# ATABEY_AGENT_RUNTIME=
# ATABEY_AGENT_CLI=
# ATABEY_HEADLESS_APPROVAL=false
# ATABEY_HEADLESS_APPROVAL_MODE=
# ATABEY_HEADLESS_MAX_RISK=

# ─── Telemetry ─────────────────────────────────────────────────────
# ATABEY_TELEMETRY_ENABLED=false
# ATABEY_TELEMETRY_WS=
# ATABEY_TELEMETRY_FLUSH_INTERVAL=
# ATABEY_TELEMETRY_BATCH_SIZE=
# ATABEY_TELEMETRY_RATE_LIMIT=
# ATABEY_TELEMETRY_MAX_RETRIES=
# ATABEY_TELEMETRY_RETRY_DELAY=

# ─── Networking Hardening ──────────────────────────────────────────
# Allowed Host header value (DNS-rebinding protection).
# ATABEY_ALLOWED_HOST=
# ATABEY_ALLOWED_ORIGIN=

# ─── Tests & Tooling ───────────────────────────────────────────────
# Hard timeout for the run_tests MCP tool (ms, default 600000).
# ATABEY_TEST_TIMEOUT_MS=600000
