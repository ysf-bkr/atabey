{
  "$schema": "https://unpkg.com/knip@6/overview/configuration.json",
  "workspaces": {
    "packages/shared": {
      "entry": ["tests/**/*.test.ts!"]
    },
    "packages/atabey": {
      "entry": ["src/cli/index.ts", "tests/**/*.test.ts!"]
    },
    "packages/atabey-mcp": {
      "entry": ["tests/**/*.test.ts!"]
    }
  },
  "ignoreBinaries": ["netstat", "atabey"],
  "ignoreDependencies": ["tsx"],
  "ignoreExportsUsedInFile": true,
  "exclude": ["exports", "types", "duplicates"]
}
